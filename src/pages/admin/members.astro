    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .save-result {
    font-size: 0.85rem;
    padding: 0.4rem 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .save-result.success { color: #2D9D5E; }
  .save-result.error   { color: #D13B3B; }

  /* ====== Divider ====== */
  .section-divider {
    border: none;
    border-top: 1px solid var(--sl-color-gray-5);
    margin: 2rem 0;
  }

  /* ====== Loading / Empty States ====== */
