    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
    min-height: 42px;
  }
  .cancel-btn:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); background: rgba(var(--sl-color-accent-rgb,79,70,229),0.04); }
  .form-actions {
