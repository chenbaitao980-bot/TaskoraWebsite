---
import AdminLayout from './layout.astro';
---

<AdminLayout title="会员配置" description="会员类型和价格配置" activePage="members">
  <div class="members-header">
    <p class="admin-hint">管理会员类型、价格、功能权限和优惠配置。</p>
  </div>

  <!-- 会员类型列表 -->
  <div class="section-title">👥 会员类型</div>
  <div id="types-loading" class="orders-loading">加载中…</div>
  <div id="types-table-wrap" class="hidden">
    <table class="orders-table types-table">
      <thead>
        <tr>
          <th>名称</th>
          <th>价格</th>
          <th>时长（天）</th>
          <th>用户数</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="types-tbody"></tbody>
    </table>
  </div>
  <div id="types-empty" class="orders-empty hidden">暂无会员类型</div>
  <button id="add-type-btn" class="save-btn" style="margin-top: 1rem;">+ 添加会员类型</button>

  <hr class="section-divider" />

  <!-- 会员类型编辑表单 -->
  <div id="type-form-section" class="hidden">
    <div class="section-title" id="type-form-title">添加会员类型</div>
    <form id="type-form" class="links-form">
      <input type="hidden" id="type-id" />
      <div class="link-card">
        <div class="link-label">名称</div>
        <input type="text" id="type-name" placeholder="例：月度 VIP" required />
      </div>
      <div class="link-card">
        <div class="link-label">价格（元）</div>
        <input type="number" id="type-price" step="0.01" min="0" placeholder="9.9" required />
      </div>
      <div class="link-card">
        <div class="link-label">时长（天）</div>
        <input type="number" id="type-duration" min="1" placeholder="30" required />
      </div>

      <div class="section-title" style="margin-top: 1rem;">🔧 功能权限</div>
      <div class="link-card toggle-card">
        <label class="toggle-label">
          <input type="checkbox" id="type-ai-decompose" checked />
          <span>AI 分解</span>
        </label>
      </div>
      <div class="link-card toggle-card">
        <label class="toggle-label">
          <input type="checkbox" id="type-data-export" checked />
          <span>数据导出</span>
        </label>
      </div>
      <div class="link-card">
        <div class="link-label">最大项目数（-1 为无限制）</div>
        <input type="number" id="type-max-projects" min="-1" placeholder="-1" />
      </div>
      <div class="link-card">
        <div class="link-label">最大任务数（-1 为无限制）</div>
        <input type="number" id="type-max-tasks" min="-1" placeholder="-1" />
      </div>

      <div class="section-title" style="margin-top: 1rem;">🎁 其他配置</div>
      <div class="link-card toggle-card">
        <label class="toggle-label">
          <input type="checkbox" id="type-auto-renew" />
          <span>支持自动续费</span>
        </label>
      </div>
      <div class="link-card">
        <div class="link-label">试用期（天，0 为无试用）</div>
        <input type="number" id="type-trial-days" min="0" placeholder="0" />
      </div>
      <div class="link-card">
        <div class="link-label">邀请返利比例（0-100%）</div>
        <input type="number" id="type-referral-bonus" min="0" max="100" placeholder="0" />
      </div>

      <div class="form-actions">
        <button type="submit" class="save-btn" id="type-save-btn">保存</button>
        <button type="button" class="cancel-btn" id="type-cancel-btn">取消</button>
      </div>
      <div id="type-save-result" class="save-result hidden"></div>
    </form>
  </div>

  <hr class="section-divider" />

  <!-- 折扣码管理 -->
  <div class="section-title">🎫 折扣码</div>
  <div id="discounts-loading" class="orders-loading">加载中…</div>
  <div id="discounts-table-wrap" class="hidden">
    <table class="orders-table">
      <thead>
        <tr>
          <th>折扣码</th>
          <th>折扣比例</th>
          <th>适用类型</th>
          <th>使用次数</th>
          <th>状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="discounts-tbody"></tbody>
    </table>
  </div>
  <div id="discounts-empty" class="orders-empty hidden">暂无折扣码</div>
  <button id="add-discount-btn" class="save-btn" style="margin-top: 1rem;">+ 添加折扣码</button>

  <!-- 折扣码编辑表单 -->
  <div id="discount-form-section" class="hidden" style="margin-top: 1rem;">
    <div class="section-title" id="discount-form-title">添加折扣码</div>
    <form id="discount-form" class="links-form">
      <input type="hidden" id="discount-id" />
      <div class="link-card">
        <div class="link-label">折扣码</div>
        <input type="text" id="discount-code" placeholder="例：VIP50" required />
      </div>
      <div class="link-card">
        <div class="link-label">折扣比例（1-100，例：80 表示八折）</div>
        <input type="number" id="discount-percent" min="1" max="100" placeholder="80" required />
      </div>
      <div class="link-card">
        <div class="link-label">适用会员类型 ID（留空则全部适用）</div>
        <input type="text" id="discount-type-id" placeholder="可选" />
      </div>
      <div class="link-card toggle-card">
        <label class="toggle-label">
          <input type="checkbox" id="discount-active" checked />
          <span>启用</span>
        </label>
      </div>
      <div class="form-actions">
        <button type="submit" class="save-btn" id="discount-save-btn">保存</button>
        <button type="button" class="cancel-btn" id="discount-cancel-btn">取消</button>
      </div>
      <div id="discount-save-result" class="save-result hidden"></div>
    </form>
  </div>

  <hr class="section-divider" />

  <!-- 充值梯度管理 -->
  <div class="section-title">💰 充值梯度</div>
  <div id="tiers-loading" class="orders-loading">加载中…</div>
  <div id="tiers-table-wrap" class="hidden">
    <table class="orders-table">
      <thead>
        <tr>
          <th>充值金额</th>
          <th>赠送金额</th>
          <th>排序</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="tiers-tbody"></tbody>
    </table>
  </div>
  <div id="tiers-empty" class="orders-empty hidden">暂无充值梯度</div>
  <button id="add-tier-btn" class="save-btn" style="margin-top: 1rem;">+ 添加充值梯度</button>

  <!-- 充值梯度编辑表单 -->
  <div id="tier-form-section" class="hidden" style="margin-top: 1rem;">
    <div class="section-title" id="tier-form-title">添加充值梯度</div>
    <form id="tier-form" class="links-form">
      <input type="hidden" id="tier-id" />
      <div class="link-card">
        <div class="link-label">充值金额（元）</div>
        <input type="number" id="tier-amount" step="0.01" min="0" placeholder="10" required />
      </div>
      <div class="link-card">
        <div class="link-label">赠送金额（元）</div>
        <input type="number" id="tier-bonus" step="0.01" min="0" placeholder="0" />
      </div>
      <div class="link-card">
        <div class="link-label">排序（越小越靠前）</div>
        <input type="number" id="tier-sort" min="0" placeholder="0" />
      </div>
      <div class="form-actions">
        <button type="submit" class="save-btn" id="tier-save-btn">保存</button>
        <button type="button" class="cancel-btn" id="tier-cancel-btn">取消</button>
      </div>
      <div id="tier-save-result" class="save-result hidden"></div>
    </form>
  </div>

  <hr class="section-divider" />

  <!-- 操作日志 -->
  <div class="section-title">📝 操作日志</div>
  <div id="logs-loading" class="orders-loading">加载中…</div>
  <div id="logs-table-wrap" class="hidden">
    <table class="orders-table">
      <thead>
        <tr>
          <th>时间</th>
          <th>操作者</th>
          <th>操作</th>
          <th>详情</th>
        </tr>
      </thead>
      <tbody id="logs-tbody"></tbody>
    </table>
  </div>
  <div id="logs-empty" class="orders-empty hidden">暂无日志</div>
</AdminLayout>

<script>
  const SUPABASE_URL = 'https://wlehkvsxftyxmxelcaps.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF';

  // --- 会员类型 ---
  interface MemberType {
    id: string;
    name: string;
    price: number;
    duration_days: number;
    max_projects: number;
    max_tasks: number;
    ai_decompose: boolean;
    data_export: boolean;
    auto_renew: boolean;
    trial_days: number;
    referral_bonus: number;
    user_count: number;
  }

  let allTypes: MemberType[] = [];

  async function loadTypes(token: string) {
    const loadingEl = document.getElementById('types-loading')!;
    const tableWrap = document.getElementById('types-table-wrap')!;
    const emptyEl = document.getElementById('types-empty')!;
    const tbody = document.getElementById('types-tbody')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/member_types?select=*,user_count:user_subscriptions(count)&order=sort_order.asc`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const types: MemberType[] = await res.json();
      allTypes = types;

      loadingEl.classList.add('hidden');
      if (types.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      tbody.innerHTML = types.map(t => `
        <tr>
          <td>${escapeHtml(t.name)}</td>
          <td>¥${t.price}</td>
          <td>${t.duration_days}</td>
          <td>${t.user_count ?? 0}</td>
          <td>
            <button class="edit-btn" data-id="${t.id}">编辑</button>
            <button class="delete-btn" data-id="${t.id}" data-name="${escapeHtml(t.name)}" data-count="${t.user_count ?? 0}">删除</button>
          </td>
        </tr>
      `).join('');

      // Bind edit/delete buttons
      tbody.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id!;
          const type = types.find(t => t.id === id);
          if (type) showTypeForm(type);
        });
      });
      tbody.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          const id = el.dataset.id!;
          const name = el.dataset.name!;
          const count = parseInt(el.dataset.count || '0', 10);
          if (count > 0) {
            alert(`无法删除「${name}」：该类型仍有 ${count} 个活跃用户。`);
            return;
          }
          if (confirm(`确定删除「${name}」吗？`)) {
            deleteType(token, id);
          }
        });
      });

      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
      alert(`加载失败：${err instanceof Error ? err.message : String(err)}`);
    }
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function showTypeForm(type?: MemberType) {
    const section = document.getElementById('type-form-section')!;
    const title = document.getElementById('type-form-title')!;
    section.classList.remove('hidden');

    if (type) {
      title.textContent = '编辑会员类型';
      (document.getElementById('type-id') as HTMLInputElement).value = type.id;
      (document.getElementById('type-name') as HTMLInputElement).value = type.name;
      (document.getElementById('type-price') as HTMLInputElement).value = String(type.price);
      (document.getElementById('type-duration') as HTMLInputElement).value = String(type.duration_days);
      (document.getElementById('type-ai-decompose') as HTMLInputElement).checked = type.ai_decompose;
      (document.getElementById('type-data-export') as HTMLInputElement).checked = type.data_export;
      (document.getElementById('type-max-projects') as HTMLInputElement).value = String(type.max_projects);
      (document.getElementById('type-max-tasks') as HTMLInputElement).value = String(type.max_tasks);
      (document.getElementById('type-auto-renew') as HTMLInputElement).checked = type.auto_renew;
      (document.getElementById('type-trial-days') as HTMLInputElement).value = String(type.trial_days);
      (document.getElementById('type-referral-bonus') as HTMLInputElement).value = String(type.referral_bonus);
    } else {
      title.textContent = '添加会员类型';
      (document.getElementById('type-form') as HTMLFormElement).reset();
      (document.getElementById('type-id') as HTMLInputElement).value = '';
    }
    section.scrollIntoView({ behavior: 'smooth' });
  }

  document.getElementById('add-type-btn')?.addEventListener('click', () => showTypeForm());
  document.getElementById('type-cancel-btn')?.addEventListener('click', () => {
    document.getElementById('type-form-section')!.classList.add('hidden');
  });

  document.getElementById('type-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const btn = document.getElementById('type-save-btn') as HTMLButtonElement;
    const resultEl = document.getElementById('type-save-result')!;
    btn.disabled = true;
    btn.textContent = '保存中…';
    resultEl.classList.add('hidden');

    const id = (document.getElementById('type-id') as HTMLInputElement).value;
    const payload = {
      name: (document.getElementById('type-name') as HTMLInputElement).value.trim(),
      price: parseFloat((document.getElementById('type-price') as HTMLInputElement).value),
      duration_days: parseInt((document.getElementById('type-duration') as HTMLInputElement).value, 10),
      ai_decompose: (document.getElementById('type-ai-decompose') as HTMLInputElement).checked,
      data_export: (document.getElementById('type-data-export') as HTMLInputElement).checked,
      max_projects: parseInt((document.getElementById('type-max-projects') as HTMLInputElement).value || '-1', 10),
      max_tasks: parseInt((document.getElementById('type-max-tasks') as HTMLInputElement).value || '-1', 10),
      auto_renew: (document.getElementById('type-auto-renew') as HTMLInputElement).checked,
      trial_days: parseInt((document.getElementById('type-trial-days') as HTMLInputElement).value || '0', 10),
      referral_bonus: parseInt((document.getElementById('type-referral-bonus') as HTMLInputElement).value || '0', 10),
    };

    try {
      const url = id
        ? `${SUPABASE_URL}/rest/v1/member_types?id=eq.${id}`
        : `${SUPABASE_URL}/rest/v1/member_types`;
      const method = id ? 'PATCH' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
          'Prefer': 'return=representation',
        },
        body: JSON.stringify(payload),
      });
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`保存失败 (${res.status})`);

      // Log the operation
      const saved = await res.json();
      const typeId = id || saved[0]?.id;
      await logOperation(token, id ? 'update_type' : 'create_type', `会员类型: ${payload.name}`, JSON.stringify(payload));

      resultEl.textContent = '✓ 保存成功';
      resultEl.className = 'save-result success';
      resultEl.classList.remove('hidden');

      // Reload
      await loadTypes(token);
      setTimeout(() => {
        document.getElementById('type-form-section')!.classList.add('hidden');
      }, 1000);
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      resultEl.textContent = `✗ ${msg}`;
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '保存';
    }
  });

  async function deleteType(token: string, id: string) {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/member_types?id=eq.${id}`, {
        method: 'DELETE',
        headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` },
      });
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`删除失败 (${res.status})`);

      await logOperation(token, 'delete_type', `删除会员类型 ID: ${id}`, '');
      await loadTypes(token);
    } catch (err: unknown) {
      alert(`删除失败：${err instanceof Error ? err.message : String(err)}`);
    }
  }

  // --- 折扣码 ---
  interface DiscountCode {
    id: string;
    code: string;
    percent: number;
    type_id: string | null;
    active: boolean;
    used_count: number;
  }

  async function loadDiscounts(token: string) {
    const loadingEl = document.getElementById('discounts-loading')!;
    const tableWrap = document.getElementById('discounts-table-wrap')!;
    const emptyEl = document.getElementById('discounts-empty')!;
    const tbody = document.getElementById('discounts-tbody')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/member_discount_codes?select=*&order=created_at.desc`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) { window.location.href = '/admin-login'; return; }
      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const codes: DiscountCode[] = await res.json();
      loadingEl.classList.add('hidden');

      if (codes.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      tbody.innerHTML = codes.map(c => {
        const typeName = c.type_id ? (allTypes.find(t => t.id === c.type_id)?.name || c.type_id) : '全部';
        return `
          <tr>
            <td class="order-no">${escapeHtml(c.code)}</td>
            <td>${c.percent}%（${(10 - c.percent / 10).toFixed(1)}折）</td>
            <td>${typeName}</td>
            <td>${c.used_count}</td>
            <td><span class="status-badge ${c.active ? 'status-paid' : 'status-closed'}">${c.active ? '启用' : '禁用'}</span></td>
            <td>
              <button class="edit-discount-btn" data-id="${c.id}">编辑</button>
              <button class="delete-discount-btn" data-id="${c.id}" data-code="${escapeHtml(c.code)}">删除</button>
            </td>
          </tr>
        `;
      }).join('');

      tbody.querySelectorAll('.edit-discount-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id!;
          const code = codes.find(c => c.id === id);
          if (code) showDiscountForm(code);
        });
      });
      tbody.querySelectorAll('.delete-discount-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const el = btn as HTMLElement;
          const id = el.dataset.id!;
          const code = el.dataset.code!;
          if (confirm(`确定删除折扣码「${code}」吗？`)) {
            await fetch(`${SUPABASE_URL}/rest/v1/member_discount_codes?id=eq.${id}`, {
              method: 'DELETE',
              headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` },
            });
            await logOperation(token, 'delete_discount', `删除折扣码: ${code}`, '');
            await loadDiscounts(token);
          }
        });
      });

      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
      alert(`加载失败：${err instanceof Error ? err.message : String(err)}`);
    }
  }

  function showDiscountForm(code?: DiscountCode) {
    const section = document.getElementById('discount-form-section')!;
    const title = document.getElementById('discount-form-title')!;
    section.classList.remove('hidden');

    if (code) {
      title.textContent = '编辑折扣码';
      (document.getElementById('discount-id') as HTMLInputElement).value = code.id;
      (document.getElementById('discount-code') as HTMLInputElement).value = code.code;
      (document.getElementById('discount-percent') as HTMLInputElement).value = String(code.percent);
      (document.getElementById('discount-type-id') as HTMLInputElement).value = code.type_id || '';
      (document.getElementById('discount-active') as HTMLInputElement).checked = code.active;
    } else {
      title.textContent = '添加折扣码';
      (document.getElementById('discount-form') as HTMLFormElement).reset();
      (document.getElementById('discount-id') as HTMLInputElement).value = '';
    }
    section.scrollIntoView({ behavior: 'smooth' });
  }

  document.getElementById('add-discount-btn')?.addEventListener('click', () => showDiscountForm());
  document.getElementById('discount-cancel-btn')?.addEventListener('click', () => {
    document.getElementById('discount-form-section')!.classList.add('hidden');
  });

  document.getElementById('discount-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const btn = document.getElementById('discount-save-btn') as HTMLButtonElement;
    const resultEl = document.getElementById('discount-save-result')!;
    btn.disabled = true;
    btn.textContent = '保存中…';
    resultEl.classList.add('hidden');

    const id = (document.getElementById('discount-id') as HTMLInputElement).value;
    const typeIdRaw = (document.getElementById('discount-type-id') as HTMLInputElement).value.trim();
    const payload = {
      code: (document.getElementById('discount-code') as HTMLInputElement).value.trim().toUpperCase(),
      percent: parseInt((document.getElementById('discount-percent') as HTMLInputElement).value, 10),
      type_id: typeIdRaw || null,
      active: (document.getElementById('discount-active') as HTMLInputElement).checked,
    };

    try {
      const url = id
        ? `${SUPABASE_URL}/rest/v1/member_discount_codes?id=eq.${id}`
        : `${SUPABASE_URL}/rest/v1/member_discount_codes`;
      const method = id ? 'PATCH' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });
      if (res.status === 401) { window.location.href = '/admin-login'; return; }
      if (!res.ok) throw new Error(`保存失败 (${res.status})`);

      await logOperation(token, id ? 'update_discount' : 'create_discount', `折扣码: ${payload.code}`, JSON.stringify(payload));
      resultEl.textContent = '✓ 保存成功';
      resultEl.className = 'save-result success';
      resultEl.classList.remove('hidden');

      await loadDiscounts(token);
      setTimeout(() => {
        document.getElementById('discount-form-section')!.classList.add('hidden');
      }, 1000);
    } catch (err: unknown) {
      resultEl.textContent = `✗ ${err instanceof Error ? err.message : String(err)}`;
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '保存';
    }
  });

  // --- 充值梯度 ---
  interface RechargeTier {
    id: string;
    amount: number;
    bonus: number;
    sort_order: number;
  }

  async function loadTiers(token: string) {
    const loadingEl = document.getElementById('tiers-loading')!;
    const tableWrap = document.getElementById('tiers-table-wrap')!;
    const emptyEl = document.getElementById('tiers-empty')!;
    const tbody = document.getElementById('tiers-tbody')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/member_recharge_tiers?select=*&order=sort_order.asc,amount.asc`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) { window.location.href = '/admin-login'; return; }
      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const tiers: RechargeTier[] = await res.json();
      loadingEl.classList.add('hidden');

      if (tiers.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      tbody.innerHTML = tiers.map(t => `
        <tr>
          <td>¥${t.amount}</td>
          <td>¥${t.bonus}</td>
          <td>${t.sort_order}</td>
          <td>
            <button class="edit-tier-btn" data-id="${t.id}">编辑</button>
            <button class="delete-tier-btn" data-id="${t.id}">删除</button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll('.edit-tier-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id!;
          const tier = tiers.find(t => t.id === id);
          if (tier) showTierForm(tier);
        });
      });
      tbody.querySelectorAll('.delete-tier-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const el = btn as HTMLElement;
          const id = el.dataset.id!;
          if (confirm('确定删除此充值梯度吗？')) {
            await fetch(`${SUPABASE_URL}/rest/v1/member_recharge_tiers?id=eq.${id}`, {
              method: 'DELETE',
              headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` },
            });
            await logOperation(token, 'delete_tier', `删除充值梯度 ID: ${id}`, JSON.stringify({ id }));
            await loadTiers(token);
          }
        });
      });

      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
      alert(`加载失败：${err instanceof Error ? err.message : String(err)}`);
    }
  }

  function showTierForm(tier?: RechargeTier) {
    const section = document.getElementById('tier-form-section')!;
    const title = document.getElementById('tier-form-title')!;
    section.classList.remove('hidden');

    if (tier) {
      title.textContent = '编辑充值梯度';
      (document.getElementById('tier-id') as HTMLInputElement).value = tier.id;
      (document.getElementById('tier-amount') as HTMLInputElement).value = String(tier.amount);
      (document.getElementById('tier-bonus') as HTMLInputElement).value = String(tier.bonus);
      (document.getElementById('tier-sort') as HTMLInputElement).value = String(tier.sort_order);
    } else {
      title.textContent = '添加充值梯度';
      (document.getElementById('tier-form') as HTMLFormElement).reset();
      (document.getElementById('tier-id') as HTMLInputElement).value = '';
    }
    section.scrollIntoView({ behavior: 'smooth' });
  }

  document.getElementById('add-tier-btn')?.addEventListener('click', () => showTierForm());
  document.getElementById('tier-cancel-btn')?.addEventListener('click', () => {
    document.getElementById('tier-form-section')!.classList.add('hidden');
  });

  document.getElementById('tier-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const btn = document.getElementById('tier-save-btn') as HTMLButtonElement;
    const resultEl = document.getElementById('tier-save-result')!;
    btn.disabled = true;
    btn.textContent = '保存中…';
    resultEl.classList.add('hidden');

    const id = (document.getElementById('tier-id') as HTMLInputElement).value;
    const payload = {
      amount: parseFloat((document.getElementById('tier-amount') as HTMLInputElement).value),
      bonus: parseFloat((document.getElementById('tier-bonus') as HTMLInputElement).value || '0'),
      sort_order: parseInt((document.getElementById('tier-sort') as HTMLInputElement).value || '0', 10),
    };

    try {
      const url = id
        ? `${SUPABASE_URL}/rest/v1/member_recharge_tiers?id=eq.${id}`
        : `${SUPABASE_URL}/rest/v1/member_recharge_tiers`;
      const method = id ? 'PATCH' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });
      if (res.status === 401) { window.location.href = '/admin-login'; return; }
      if (!res.ok) throw new Error(`保存失败 (${res.status})`);

      await logOperation(token, id ? 'update_tier' : 'create_tier', `充值梯度: ¥${payload.amount}`, JSON.stringify(payload));
      resultEl.textContent = '✓ 保存成功';
      resultEl.className = 'save-result success';
      resultEl.classList.remove('hidden');

      await loadTiers(token);
      setTimeout(() => {
        document.getElementById('tier-form-section')!.classList.add('hidden');
      }, 1000);
    } catch (err: unknown) {
      resultEl.textContent = `✗ ${err instanceof Error ? err.message : String(err)}`;
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '保存';
    }
  });

  // --- 操作日志 ---
  async function logOperation(token: string, action: string, detail: string, payload: string) {
    try {
      // Fetch admin email from Supabase Auth
      let adminEmail: string | null = null;
      try {
        const userRes = await fetch(`${SUPABASE_URL}/auth/v1/user`, {
          headers: {
            'Authorization': `Bearer ${token}`,
            'apikey': SUPABASE_ANON_KEY,
          },
        });
        if (userRes.ok) {
          const userData = await userRes.json();
          adminEmail = userData.email ?? null;
        }
      } catch {
        // Ignore email fetch errors
      }

      await fetch(`${SUPABASE_URL}/rest/v1/member_config_logs`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({ action, detail, payload, admin_email: adminEmail }),
      });
    } catch {
      // Ignore log errors
    }
  }

  async function loadLogs(token: string) {
    const loadingEl = document.getElementById('logs-loading')!;
    const tableWrap = document.getElementById('logs-table-wrap')!;
    const emptyEl = document.getElementById('logs-empty')!;
    const tbody = document.getElementById('logs-tbody')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/member_config_logs?select=*&order=created_at.desc&limit=50`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) { window.location.href = '/admin-login'; return; }
      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const logs: { id: string; action: string; detail: string; admin_email: string; created_at: string }[] = await res.json();
      loadingEl.classList.add('hidden');

      if (logs.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      const ACTION_LABELS: Record<string, string> = {
        create_type: '创建会员类型',
        update_type: '更新会员类型',
        delete_type: '删除会员类型',
        create_discount: '创建折扣码',
        update_discount: '更新折扣码',
        delete_discount: '删除折扣码',
        create_tier: '创建充值梯度',
        update_tier: '更新充值梯度',
        delete_tier: '删除充值梯度',
      };

      tbody.innerHTML = logs.map(l => {
        const d = new Date(l.created_at);
        const time = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
        return `
          <tr>
            <td>${time}</td>
            <td>${escapeHtml(l.admin_email || '—')}</td>
            <td>${ACTION_LABELS[l.action] || l.action}</td>
            <td class="log-detail" title="${escapeHtml(l.detail)}">${escapeHtml(l.detail).slice(0, 60)}${l.detail.length > 60 ? '…' : ''}</td>
          </tr>
        `;
      }).join('');

      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
    }
  }

  // --- Initialize ---
  const token = localStorage.getItem('taskora_admin_token');
  if (token) {
    loadTypes(token);
    loadDiscounts(token);
    loadTiers(token);
    loadLogs(token);
  }
</script>

