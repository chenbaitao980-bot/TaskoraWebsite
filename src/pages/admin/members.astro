    font-size: 0.95rem;
    font-weight: 700;
    color: var(--sl-color-text);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.01em;
  }
  .section-icon {
    flex-shrink: 0;
    color: var(--sl-color-accent);
    opacity: 0.85;
  }

  /* ====== Form ====== */
  .links-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .link-card {
