---
import AdminLayout from './layout.astro';
---

<AdminLayout title="内容配置" description="帮助与反馈、关于页面内容管理" activePage="config">
  <div class="payment-header">
    <p class="admin-hint">管理 App「帮助与反馈」和「关于」页面的展示内容。修改后 App 下次启动时自动拉取最新内容。</p>
  </div>

  <div id="config-loading" class="orders-loading">加载中…</div>
  <div id="config-error" class="save-result error hidden"></div>

  <!-- 帮助与反馈 -->
  <div id="config-form-wrap" class="hidden">

    <form id="help-form" class="links-form">
      <div class="section-title">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        帮助与反馈 — 常用功能
      </div>
      <div id="help-common-items"></div>

      <div class="section-title" style="margin-top:20px">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        帮助与反馈 — 常见问题
      </div>
      <div id="help-faq-items"></div>

      <div class="section-title" style="margin-top:20px">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        帮助与反馈 — 反馈方式
      </div>
      <div id="help-feedback-items"></div>

      <button type="submit" class="save-btn" id="help-save-btn">保存帮助页内容</button>
      <div id="help-save-result" class="save-result hidden"></div>
    </form>

    <hr class="section-divider" />

    <!-- 关于页面 -->
    <form id="about-form" class="links-form">
      <div class="section-title">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        关于 — 核心能力
      </div>
      <div id="about-core-items"></div>

      <div class="section-title" style="margin-top:20px">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        关于 — 数据与同步
      </div>
      <div id="about-sync-items"></div>

      <div class="section-title" style="margin-top:20px">
        <svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        关于 — 隐私与权限
      </div>
      <div id="about-privacy-items"></div>

      <button type="submit" class="save-btn" id="about-save-btn">保存关于页内容</button>
      <div id="about-save-result" class="save-result hidden"></div>
    </form>
  </div>
</AdminLayout>

<style>
  .config-item {
    background: var(--sl-color-gray-6, #1e1e2e);
    border: 1px solid var(--sl-color-gray-5, #313244);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 10px;
  }
  .config-item-label {
    font-size: 12px;
    color: var(--sl-color-gray-2, #a6adc8);
    margin-bottom: 4px;
  }
  .config-item input,
  .config-item textarea {
    width: 100%;
    box-sizing: border-box;
  }
  .config-item textarea {
    resize: vertical;
    min-height: 60px;
  }
</style>

<script>
  const SUPABASE_URL = 'https://wlehkvsxftyxmxelcaps.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF';

  // Section definitions
  const HELP_SECTIONS = [
    {
      containerId: 'help-common-items',
      prefix: 'help.common',
      count: 4,
      hasTitle: true,
      labels: ['任务管理', 'AI 拆解', '日历提醒', '主题切换'],
    },
    {
      containerId: 'help-faq-items',
      prefix: 'help.faq',
      count: 3,
      hasTitle: true,
      labels: ['常见问题 1', '常见问题 2', '常见问题 3'],
    },
    {
      containerId: 'help-feedback-items',
      prefix: 'help.feedback',
      count: 2,
      hasTitle: true,
      labels: ['反馈方式 1', '反馈方式 2'],
    },
  ];

  const ABOUT_SECTIONS = [
    {
      containerId: 'about-core-items',
      prefix: 'about.core',
      count: 3,
      hasTitle: false,
      labels: ['核心能力 1', '核心能力 2', '核心能力 3'],
    },
    {
      containerId: 'about-sync-items',
      prefix: 'about.sync',
      count: 3,
      hasTitle: false,
      labels: ['数据与同步 1', '数据与同步 2', '数据与同步 3'],
    },
    {
      containerId: 'about-privacy-items',
      prefix: 'about.privacy',
      count: 3,
      hasTitle: false,
      labels: ['隐私与权限 1', '隐私与权限 2', '隐私与权限 3'],
    },
  ];

  function renderSection(
    containerId: string,
    prefix: string,
    count: number,
    hasTitle: boolean,
    labels: string[],
    cfg: Record<string, string>
  ) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const div = document.createElement('div');
      div.className = 'config-item';
      if (hasTitle) {
        const titleKey = `${prefix}.${i}.title`;
        div.innerHTML += `
          <div class="config-item-label">${labels[i]} — 标题</div>
          <input type="text" id="${titleKey}" value="${escHtml(cfg[titleKey] ?? '')}" placeholder="标题" />
          <div class="config-item-label" style="margin-top:8px">正文</div>
          <textarea id="${prefix}.${i}.body">${escHtml(cfg[`${prefix}.${i}.body`] ?? '')}</textarea>
        `;
      } else {
        const key = `${prefix}.${i}`;
        div.innerHTML += `
          <div class="config-item-label">${labels[i]}</div>
          <textarea id="${key}">${escHtml(cfg[key] ?? '')}</textarea>
        `;
      }
      container.appendChild(div);
    }
  }

  function escHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function collectRecords(sections: typeof HELP_SECTIONS): { key: string; value: string; updated_at: string }[] {
    const now = new Date().toISOString();
    const records: { key: string; value: string; updated_at: string }[] = [];
    for (const sec of sections) {
      for (let i = 0; i < sec.count; i++) {
        if (sec.hasTitle) {
          const titleKey = `${sec.prefix}.${i}.title`;
          const bodyKey = `${sec.prefix}.${i}.body`;
          const titleVal = (document.getElementById(titleKey) as HTMLInputElement)?.value.trim() ?? '';
          const bodyVal = (document.getElementById(bodyKey) as HTMLTextAreaElement)?.value.trim() ?? '';
          records.push({ key: titleKey, value: titleVal, updated_at: now });
          records.push({ key: bodyKey, value: bodyVal, updated_at: now });
        } else {
          const key = `${sec.prefix}.${i}`;
          const val = (document.getElementById(key) as HTMLTextAreaElement)?.value.trim() ?? '';
          records.push({ key, value: val, updated_at: now });
        }
      }
    }
    return records;
  }

  async function saveRecords(
    records: { key: string; value: string; updated_at: string }[],
    token: string,
    btnId: string,
    resultId: string
  ) {
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    const resultEl = document.getElementById(resultId)!;
    btn.disabled = true;
    btn.textContent = '保存中…';
    resultEl.classList.add('hidden');

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/app_config`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
          'Prefer': 'resolution=merge-duplicates',
        },
        body: JSON.stringify(records),
      });
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`保存失败 (${res.status})`);
      resultEl.textContent = '✓ 已保存';
      resultEl.className = 'save-result success';
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      resultEl.textContent = `✗ ${msg}`;
      resultEl.className = 'save-result error';
    } finally {
      btn.disabled = false;
      btn.textContent = btn.id === 'help-save-btn' ? '保存帮助页内容' : '保存关于页内容';
      resultEl.classList.remove('hidden');
    }
  }

  async function init() {
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const loadingEl = document.getElementById('config-loading')!;
    const errorEl = document.getElementById('config-error')!;
    const formWrap = document.getElementById('config-form-wrap')!;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/app_config?select=key,value`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`加载失败 (${res.status})`);

      const rows: { key: string; value: string }[] = await res.json();
      const cfg: Record<string, string> = {};
      for (const r of rows) cfg[r.key] = r.value;

      for (const sec of [...HELP_SECTIONS, ...ABOUT_SECTIONS]) {
        renderSection(sec.containerId, sec.prefix, sec.count, sec.hasTitle, sec.labels, cfg);
      }

      loadingEl.classList.add('hidden');
      formWrap.classList.remove('hidden');
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      loadingEl.classList.add('hidden');
      errorEl.textContent = `加载失败：${msg}`;
      errorEl.classList.remove('hidden');
    }

    document.getElementById('help-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const t = localStorage.getItem('taskora_admin_token');
      if (!t) { window.location.href = '/admin-login'; return; }
      saveRecords(collectRecords(HELP_SECTIONS), t, 'help-save-btn', 'help-save-result');
    });

    document.getElementById('about-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const t = localStorage.getItem('taskora_admin_token');
      if (!t) { window.location.href = '/admin-login'; return; }
      saveRecords(collectRecords(ABOUT_SECTIONS), t, 'about-save-btn', 'about-save-result');
    });
  }

  // Wait for layout auth check to expose the token
  document.addEventListener('DOMContentLoaded', () => {
    const layoutEl = document.getElementById('admin-layout');
    if (layoutEl && !layoutEl.classList.contains('hidden')) {
      init();
    } else {
      const observer = new MutationObserver(() => {
        if (!layoutEl?.classList.contains('hidden')) {
          observer.disconnect();
          init();
        }
      });
      observer.observe(layoutEl || document.body, { attributes: true, attributeFilter: ['class'] });
    }
  });
</script>
