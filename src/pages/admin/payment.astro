---
import AdminLayout from './layout.astro';
---

<AdminLayout title="支付配置" description="支付宝配置和订单管理" activePage="payment">
  <div class="payment-header">
    <p class="admin-hint">配置支付宝参数，查看支付订单记录。</p>
  </div>

  <!-- 支付宝配置表单 -->
  <form id="payment-form" class="links-form">
    <div class="section-title"><svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg> 支付宝配置</div>
    <div class="link-card">
      <div class="link-label">AppID（16位数字）</div>
      <input type="text" id="field-alipay-appid" placeholder="2088xxxxxxxxxxxxxxx" autocomplete="off" />
    </div>
    <div class="link-card">
      <div class="link-label">应用私钥（PKCS8 格式）</div>
      <textarea id="field-alipay-private-key" rows="4" placeholder="（已设置，留空则不修改）" autocomplete="off" class="config-textarea"></textarea>
    </div>
    <div class="link-card">
      <div class="link-label">支付宝公钥（平台公钥，非应用公钥）</div>
      <textarea id="field-alipay-public-key" rows="4" placeholder="（已设置，留空则不修改）" autocomplete="off" class="config-textarea"></textarea>
    </div>
    <button type="submit" class="save-btn" id="payment-save-btn">保存支付配置</button>
    <div id="payment-save-result" class="save-result hidden"></div>
  </form>

  <hr class="section-divider" />

  <!-- 订单管理 -->
  <div class="links-form">
    <div class="section-title"><svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> 支付明细</div>
    <div class="orders-toolbar">
      <select id="orders-status-filter" class="orders-filter">
        <option value="">全部状态</option>
        <option value="pending">待支付</option>
        <option value="paid">已支付</option>
        <option value="closed">已关闭</option>
      </select>
      <button id="orders-refresh-btn" class="orders-refresh-btn">刷新</button>
      <span id="orders-count" class="orders-count"></span>
    </div>
    <div id="orders-loading" class="orders-loading">加载中…</div>
    <div id="orders-table-wrap" class="hidden">
      <table class="orders-table">
        <thead>
          <tr>
            <th>订单号</th>
            <th>套餐</th>
            <th>金额</th>
            <th>状态</th>
            <th>创建时间</th>
            <th>支付时间</th>
          </tr>
        </thead>
        <tbody id="orders-tbody"></tbody>
      </table>
    </div>
    <div id="orders-empty" class="orders-empty hidden">暂无记录</div>
    <div id="orders-error" class="save-result error hidden"></div>
  </div>

  <hr class="section-divider" />

  <!-- 白名单豁免管理 -->
  <div class="links-form">
    <div class="section-title"><svg class="section-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> 白名单豁免管理</div>

    <!-- 新增白名单表单 -->
    <div class="link-card">
      <div class="link-label">新增豁免邮箱</div>
      <input type="text" id="whitelist-email-input" placeholder="user@example.com" autocomplete="off" />
      <input type="text" id="whitelist-note-input" placeholder="备注（可选）" autocomplete="off" />
      <button type="button" id="whitelist-add-btn" class="save-btn">加入白名单</button>
      <div id="whitelist-add-result" class="save-result hidden"></div>
    </div>

    <!-- 白名单列表 -->
    <div id="whitelist-loading" class="orders-loading">加载中…</div>
    <div id="whitelist-table-wrap" class="hidden">
      <table class="orders-table">
        <thead>
          <tr>
            <th>邮箱</th>
            <th>备注</th>
            <th>加入时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="whitelist-tbody"></tbody>
      </table>
    </div>
    <div id="whitelist-empty" class="orders-empty hidden">暂无白名单记录</div>
    <div id="whitelist-error" class="save-result error hidden"></div>
  </div>
</AdminLayout>

<script>
  const SUPABASE_URL = 'https://wlehkvsxftyxmxelcaps.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF';

  // --- 支付配置 ---
  async function initPaymentConfig(token: string) {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/app_config?key=in.(alipay_app_id,alipay_private_key,alipay_public_key)&select=key,value`,
      { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
    );
    if (!res.ok) return;
    const rows: { key: string; value: string }[] = await res.json();
    const cfg: Record<string, string> = {};
    for (const r of rows) cfg[r.key] = r.value;

    const appidEl = document.getElementById('field-alipay-appid') as HTMLInputElement;
    if (appidEl && cfg.alipay_app_id) appidEl.value = cfg.alipay_app_id;
    
    const privateKeyEl = document.getElementById('field-alipay-private-key') as HTMLTextAreaElement;
    const publicKeyEl = document.getElementById('field-alipay-public-key') as HTMLTextAreaElement;
    if (privateKeyEl && cfg.alipay_private_key) privateKeyEl.placeholder = '（已设置，留空则不修改）';
    if (publicKeyEl && cfg.alipay_public_key) publicKeyEl.placeholder = '（已设置，留空则不修改）';
  }

  document.getElementById('payment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const btn = document.getElementById('payment-save-btn') as HTMLButtonElement;
    const resultEl = document.getElementById('payment-save-result')!;
    btn.disabled = true;
    btn.textContent = '保存中…';
    resultEl.classList.add('hidden');

    const appid = (document.getElementById('field-alipay-appid') as HTMLInputElement).value.trim();
    const privateKey = (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).value.trim();
    const publicKey = (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).value.trim();

    const records: { key: string; value: string }[] = [];
    if (appid) records.push({ key: 'alipay_app_id', value: appid });
    if (privateKey) records.push({ key: 'alipay_private_key', value: privateKey });
    if (publicKey) records.push({ key: 'alipay_public_key', value: publicKey });
    records.push({ key: 'alipay_gateway', value: 'https://openapi.alipay.com/gateway.do' });
    records.push({ key: 'alipay_notify_url', value: 'https://wlehkvsxftyxmxelcaps.supabase.co/functions/v1/alipay-notify' });

    if (records.length === 2) {
      btn.disabled = false;
      btn.textContent = '保存支付配置';
      resultEl.textContent = '请至少填写 AppID、私钥或公钥';
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
      return;
    }

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/app_config`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
          'Prefer': 'resolution=merge-duplicates',
        },
        body: JSON.stringify(records),
      });
      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }
      if (!res.ok) throw new Error(`保存失败 (${res.status})`);

      resultEl.textContent = '✓ 支付配置已保存';
      resultEl.className = 'save-result success';
      (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).value = '';
      (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).placeholder = '（已设置，留空则不修改）';
      (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).value = '';
      (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).placeholder = '（已设置，留空则不修改）';
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      resultEl.textContent = `✗ ${msg}`;
      resultEl.className = 'save-result error';
    } finally {
      btn.disabled = false;
      btn.textContent = '保存支付配置';
      resultEl.classList.remove('hidden');
    }
  });

  // --- 订单管理 ---
  const PLAN_LABELS: Record<string, string> = {
    vip_monthly: '月度 VIP',
    vip_yearly: '年度 VIP',
  };
  const STATUS_LABELS: Record<string, string> = {
    pending: '待支付',
    paid: '已支付',
    closed: '已关闭',
  };
  const STATUS_CLASS: Record<string, string> = {
    pending: 'status-pending',
    paid: 'status-paid',
    closed: 'status-closed',
  };

  function formatDatetime(iso: string | null): string {
    if (!iso) return '—';
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  }

  async function loadOrders(token: string) {
    const statusFilter = (document.getElementById('orders-status-filter') as HTMLSelectElement).value;
    const loadingEl = document.getElementById('orders-loading')!;
    const tableWrap = document.getElementById('orders-table-wrap')!;
    const emptyEl = document.getElementById('orders-empty')!;
    const errorEl = document.getElementById('orders-error')!;
    const tbody = document.getElementById('orders-tbody')!;
    const countEl = document.getElementById('orders-count')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    try {
      let url = `${SUPABASE_URL}/rest/v1/payment_orders?select=out_trade_no,plan,amount,status,created_at,paid_at&order=created_at.desc&limit=100`;
      if (statusFilter) url += `&status=eq.${statusFilter}`;

      const res = await fetch(url, {
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
      });

      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const orders: { out_trade_no: string; plan: string; amount: string; status: string; created_at: string; paid_at: string | null }[] = await res.json();

      loadingEl.classList.add('hidden');
      countEl.textContent = `共 ${orders.length} 条`;

      if (orders.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      tbody.innerHTML = orders.map(o => `
        <tr>
          <td class="order-no" title="${o.out_trade_no}">${o.out_trade_no.slice(-12)}</td>
          <td>${PLAN_LABELS[o.plan] || o.plan}</td>
          <td>¥${o.amount}</td>
          <td><span class="status-badge ${STATUS_CLASS[o.status] || ''}">${STATUS_LABELS[o.status] || o.status}</span></td>
          <td>${formatDatetime(o.created_at)}</td>
          <td>${formatDatetime(o.paid_at)}</td>
        </tr>
      `).join('');
      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
      errorEl.textContent = `加载失败：${err instanceof Error ? err.message : String(err)}`;
      errorEl.classList.remove('hidden');
    }
  }

  document.getElementById('orders-refresh-btn')?.addEventListener('click', () => {
    const token = localStorage.getItem('taskora_admin_token');
    if (token) loadOrders(token);
  });
  document.getElementById('orders-status-filter')?.addEventListener('change', () => {
    const token = localStorage.getItem('taskora_admin_token');
    if (token) loadOrders(token);
  });

  // --- 白名单管理 ---
  async function loadWhitelist(token: string) {
    const loadingEl = document.getElementById('whitelist-loading')!;
    const tableWrap = document.getElementById('whitelist-table-wrap')!;
    const emptyEl = document.getElementById('whitelist-empty')!;
    const errorEl = document.getElementById('whitelist-error')!;
    const tbody = document.getElementById('whitelist-tbody')!;

    loadingEl.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/whitelist', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error(`请求失败 (${res.status})`);

      const list: { email: string; note: string | null; created_at: string }[] = await res.json();

      loadingEl.classList.add('hidden');

      if (list.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      tbody.innerHTML = list.map(item => `
        <tr>
          <td>${item.email}</td>
          <td>${item.note ?? '—'}</td>
          <td>${formatDatetime(item.created_at)}</td>
          <td>
            <button class="whitelist-del-btn" data-email="${item.email}">移除</button>
          </td>
        </tr>
      `).join('');

      // 绑定删除按钮
      tbody.querySelectorAll<HTMLButtonElement>('.whitelist-del-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const email = btn.dataset.email!;
          if (!confirm(`确认将 ${email} 从白名单移除？`)) return;
          btn.disabled = true;
          btn.textContent = '移除中…';
          const t = localStorage.getItem('taskora_admin_token');
          if (!t) { window.location.href = '/admin-login'; return; }
          try {
            const delRes = await fetch('/api/admin/whitelist', {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${t}`,
              },
              body: JSON.stringify({ email }),
            });
            if (!delRes.ok) {
              const errData = await delRes.json().catch(() => ({}));
              throw new Error(errData.error || `删除失败 (${delRes.status})`);
            }
            await loadWhitelist(t);
          } catch (err: unknown) {
            btn.disabled = false;
            btn.textContent = '移除';
            alert(`移除失败：${err instanceof Error ? err.message : String(err)}`);
          }
        });
      });

      tableWrap.classList.remove('hidden');
    } catch (err: unknown) {
      loadingEl.classList.add('hidden');
      errorEl.textContent = `加载失败：${err instanceof Error ? err.message : String(err)}`;
      errorEl.classList.remove('hidden');
    }
  }

  document.getElementById('whitelist-add-btn')?.addEventListener('click', async () => {
    const token = localStorage.getItem('taskora_admin_token');
    if (!token) { window.location.href = '/admin-login'; return; }

    const emailInput = document.getElementById('whitelist-email-input') as HTMLInputElement;
    const noteInput = document.getElementById('whitelist-note-input') as HTMLInputElement;
    const btn = document.getElementById('whitelist-add-btn') as HTMLButtonElement;
    const resultEl = document.getElementById('whitelist-add-result')!;

    const email = emailInput.value.trim();
    const note = noteInput.value.trim();

    if (!email) {
      resultEl.textContent = '请输入邮箱';
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = '添加中…';
    resultEl.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/whitelist', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({ email, note }),
      });

      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `添加失败 (${res.status})`);

      resultEl.textContent = `✓ 已将 ${email} 加入白名单`;
      resultEl.className = 'save-result success';
      resultEl.classList.remove('hidden');
      emailInput.value = '';
      noteInput.value = '';
      await loadWhitelist(token);
    } catch (err: unknown) {
      resultEl.textContent = `✗ ${err instanceof Error ? err.message : String(err)}`;
      resultEl.className = 'save-result error';
      resultEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '加入白名单';
    }
  });

  // Initialize
  const token = localStorage.getItem('taskora_admin_token');
  if (token) {
    initPaymentConfig(token);
    loadOrders(token);
    loadWhitelist(token);
  }
</script>

<style>
  .payment-header {
    margin-bottom: 1.5rem;
  }
  .admin-hint {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    margin: 0;
  }
  .links-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 640px;
  }
  .link-card {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .link-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }
  .link-card input[type="text"] {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.9rem;
    width: 100%;
    box-sizing: border-box;
  }
  .link-card input[type="text"]:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .config-textarea {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.85rem;
    font-family: monospace;
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
  }
  .config-textarea:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .save-btn {
    padding: 0.7rem 2rem;
    border: none;
    border-radius: 8px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    align-self: flex-start;
  }
   .save-btn:disabled {
     opacity: 0.6;
     cursor: default;
   }
   .save-btn:hover:not(:disabled) {
     filter: brightness(1.1);
   }
   .save-btn:active:not(:disabled) {
     transform: scale(0.98);
   }
  .save-result {
    font-size: 0.875rem;
    padding: 0.5rem 0;
  }
  .save-result.success { color: #2D9D5E; }
  .save-result.error { color: #D13B3B; }
  .section-divider {
    border: none;
    border-top: 1px solid var(--sl-color-gray-5);
    margin: 2rem 0;
    max-width: 640px;
  }
  .section-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--sl-color-text);
    margin-bottom: 0.25rem;
  }
  .orders-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .orders-filter {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .orders-refresh-btn {
    padding: 0.4rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: transparent;
    color: var(--sl-color-text);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .orders-refresh-btn:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
  .orders-count { font-size: 0.8rem; color: var(--sl-color-gray-2); }
  .orders-loading { font-size: 0.875rem; color: var(--sl-color-gray-2); padding: 1rem 0; }
  .orders-empty { font-size: 0.875rem; color: var(--sl-color-gray-2); padding: 1rem 0; }
   .orders-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.85rem; background: var(--sl-color-bg-nav); border-radius: 12px; border: 1px solid var(--sl-color-gray-5); overflow: hidden; }
  .orders-table th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-weight: 600;
    white-space: nowrap;
    background: var(--sl-color-bg);
    font-size: 0.78rem;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }
  .orders-table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
    vertical-align: middle;
    color: var(--sl-color-text);
    line-height: 1.5;
  }
  .orders-table tbody tr {
    transition: background-color 0.1s ease;
  }
  .orders-table tbody tr:hover {
    background: rgba(var(--sl-color-accent-rgb,79,70,229), 0.025);
  }
  .orders-table tr:last-child td { border-bottom: none; }
  .orders-table tr:last-child td:first-child { border-bottom-left-radius: 0; }
  .orders-table tr:last-child td:last-child { border-bottom-right-radius: 0; }
  .order-no { font-family: monospace; font-size: 0.8rem; color: var(--sl-color-gray-2); }
  .status-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .status-pending { background: #FEF9C3; color: #854D0E; }
  .status-paid    { background: #DCFCE7; color: #166534; }
  .status-closed  { background: #F1F5F9; color: #64748B; }
