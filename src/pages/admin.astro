---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: '下载链接管理',
    description: 'Taskora 管理员后台 — 管理各平台下载链接',
  }}
>
  <div id="admin-loading" class="status-msg">验证登录状态…</div>
  <div id="admin-content" class="hidden">
    <div class="admin-header">
      <p class="admin-hint">修改链接后点击「保存」立即生效，无需重新部署。</p>
      <button id="logout-btn" class="logout-btn">退出登录</button>
    </div>

    <div class="github-settings">
      <div class="github-settings-header">
        <span>🔑 GitHub Token 配置</span>
        <span id="github-token-status" class="token-status"></span>
      </div>
      <div class="github-settings-body">
        <input type="password" id="github-token-input" placeholder="github_pat_..." class="github-token-input" />
        <button type="button" id="github-token-save" class="token-save-btn">保存 Token</button>
      </div>
      <p class="github-token-hint">需要 Fine-grained PAT，仓库 chenbaitao980-bot/TaskoraWebsite，权限：Contents: write</p>
    </div>

    <form id="links-form" class="links-form">
      <div class="link-card">
        <div class="link-label">📱 Android APK 直链</div>
        <input type="file" id="file-input-apk" accept=".apk" class="hidden" />
        <div id="drop-zone-apk" class="drop-zone" data-platform="android_apk" data-filename="taskora-latest.apk">
          <div class="drop-zone-hint">拖拽文件到此处，或点击选择文件</div>
          <div id="drop-zone-apk-current" class="drop-zone-current">暂无文件</div>
        </div>
        <div id="upload-status-apk" class="upload-status hidden"></div>
      </div>
      <div class="link-card">
        <div class="link-label">📱 小米应用商店链接</div>
        <input type="url" id="field-android-xiaomi" name="android_xiaomi" placeholder="https://app.mi.com/details?id=..." />
      </div>
      <div class="link-card">
        <div class="link-label">💻 Windows ZIP 直链</div>
        <input type="file" id="file-input-zip" accept=".zip" class="hidden" />
        <div id="drop-zone-zip" class="drop-zone" data-platform="windows_zip" data-filename="taskora-latest.zip">
          <div class="drop-zone-hint">拖拽文件到此处，或点击选择文件</div>
          <div id="drop-zone-zip-current" class="drop-zone-current">暂无文件</div>
        </div>
        <div id="upload-status-zip" class="upload-status hidden"></div>
      </div>
      <div class="link-card">
        <div class="link-label">🌐 Web 在线版网址</div>
        <input type="url" id="field-web" name="web" placeholder="https://app.taskora.com" />
      </div>

      <button type="submit" class="save-btn" id="save-btn">保存所有链接</button>
      <div id="save-result" class="save-result hidden"></div>
    </form>
  </div>

  <script>
    const SUPABASE_URL = 'https://wlehkvsxftyxmxelcaps.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF';


    const loadingEl = document.getElementById('admin-loading')!;
    const contentEl = document.getElementById('admin-content')!;

    const token = localStorage.getItem('taskora_admin_token');
    if (!token) {
      window.location.href = '/admin-login';
    } else {
      init(token);
    }

    async function init(token: string) {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/download_links?select=platform,url`, {
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
      });

      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }

      const rows: { platform: string; url: string }[] = await res.json();
      const linkMap: Record<string, string> = {};
      for (const row of rows) linkMap[row.platform] = row.url ?? '';

      // URL input fields (xiaomi + web)
      const urlFieldMap: Record<string, string> = {
        'field-android-xiaomi': 'android_xiaomi',
        'field-web': 'web',
      };
      for (const [elId, platform] of Object.entries(urlFieldMap)) {
        const el = document.getElementById(elId) as HTMLInputElement | null;
        if (el) el.value = linkMap[platform] ?? '';
      }

      // Upload zone current file display (apk + zip)
      const apkUrl = linkMap['android_apk'] ?? '';
      const zipUrl = linkMap['windows_zip'] ?? '';

      const apkCurrentEl = document.getElementById('drop-zone-apk-current');
      const zipCurrentEl = document.getElementById('drop-zone-zip-current');

      if (apkCurrentEl) {
        apkCurrentEl.textContent = apkUrl ? getFilenameFromUrl(apkUrl) : '暂无文件';
      }
      if (zipCurrentEl) {
        zipCurrentEl.textContent = zipUrl ? getFilenameFromUrl(zipUrl) : '暂无文件';
      }

      loadingEl.classList.add('hidden');
      contentEl.classList.remove('hidden');

      setupUploadZone('apk');
      setupUploadZone('zip');

      // GitHub token status
      updateGithubTokenStatus();
    }

    function getFilenameFromUrl(url: string): string {
      try {
        const parts = url.split('/');
        return parts[parts.length - 1] || url;
      } catch {
        return url;
      }
    }

    async function uploadFile(file: File, platform: string, filename: string, statusEl: HTMLElement, currentEl: HTMLElement) {
      const token = localStorage.getItem('taskora_admin_token');
      if (!token) { window.location.href = '/admin-login'; return; }

      statusEl.className = 'upload-status loading';
      statusEl.classList.remove('hidden');

      try {
        // Step 1: Get GitHub token from localStorage
        const githubToken = localStorage.getItem('taskora_github_token');
        if (!githubToken) {
          throw new Error('请先在上方设置 GitHub Token');
        }

        const ghHeaders = {
          'Authorization': `Bearer ${githubToken}`,
          'Accept': 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
        };

        // Step 2: Get or create the "v-latest" release
        statusEl.textContent = '检查 GitHub Release…';
        let releaseId: number;
        const releaseRes = await fetch(
          'https://api.github.com/repos/chenbaitao980-bot/TaskoraWebsite/releases/tags/v-latest',
          { headers: ghHeaders }
        );

        if (releaseRes.status === 401) {
          throw new Error('GitHub Token 无效或已过期');
        }
        if (releaseRes.status === 403) {
          throw new Error('GitHub Token 权限不足（需要 Contents: write）');
        }

        if (releaseRes.ok) {
          const releaseData = await releaseRes.json();
          releaseId = releaseData.id;
        } else if (releaseRes.status === 404) {
          // Create the release
          const createRes = await fetch(
            'https://api.github.com/repos/chenbaitao980-bot/TaskoraWebsite/releases',
            {
              method: 'POST',
              headers: { ...ghHeaders, 'Content-Type': 'application/json' },
              body: JSON.stringify({
                tag_name: 'v-latest',
                name: 'Latest Release',
                draft: false,
                prerelease: false,
              }),
            }
          );
          if (createRes.status === 401) {
            throw new Error('GitHub Token 无效或已过期');
          }
          if (createRes.status === 403) {
            throw new Error('GitHub Token 权限不足（需要 Contents: write）');
          }
          if (!createRes.ok) {
            const body = await createRes.text();
            throw new Error(`GitHub 上传失败 (${createRes.status}): ${body}`);
          }
          const createData = await createRes.json();
          releaseId = createData.id;
        } else {
          const body = await releaseRes.text();
          throw new Error(`GitHub 上传失败 (${releaseRes.status}): ${body}`);
        }

        // Step 3: Delete existing asset with same filename (if any)
        const assetsRes = await fetch(
          `https://api.github.com/repos/chenbaitao980-bot/TaskoraWebsite/releases/${releaseId}/assets`,
          { headers: ghHeaders }
        );
        if (assetsRes.ok) {
          const assets: { id: number; name: string }[] = await assetsRes.json();
          const existing = assets.find(a => a.name === filename);
          if (existing) {
            await fetch(
              `https://api.github.com/repos/chenbaitao980-bot/TaskoraWebsite/releases/assets/${existing.id}`,
              { method: 'DELETE', headers: ghHeaders }
            );
          }
        }

        // Step 4: Upload new asset
        const fileSizeMB = (file.size / 1048576).toFixed(1);
        statusEl.textContent = `上传中… (${fileSizeMB} MB)`;

        const uploadRes = await fetch(
          `https://github-upload.chenbaitao980.workers.dev/?releaseId=${releaseId}&filename=${encodeURIComponent(filename)}`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/octet-stream',
            },
            body: file,
          }
        );

        if (uploadRes.status === 401) {
          throw new Error('GitHub Token 无效或已过期');
        }
        if (uploadRes.status === 403) {
          throw new Error('GitHub Token 权限不足（需要 Contents: write）');
        }
        if (!uploadRes.ok) {
          const body = await uploadRes.text();
          throw new Error(`GitHub 上传失败 (${uploadRes.status}): ${body}`);
        }

        const uploadData = await uploadRes.json();
        const browserDownloadUrl: string = uploadData.browser_download_url;

        // Step 5: Update download_links table
        const patchRes = await fetch(
          `${SUPABASE_URL}/rest/v1/download_links?platform=eq.${platform}`,
          {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'apikey': SUPABASE_ANON_KEY,
              'Authorization': `Bearer ${token}`,
              'Prefer': 'return=minimal',
            },
            body: JSON.stringify({ url: browserDownloadUrl }),
          }
        );

        if (patchRes.status === 401) {
          localStorage.removeItem('taskora_admin_token');
          window.location.href = '/admin-login';
          return;
        }
        if (!patchRes.ok) {
          throw new Error(`链接更新失败 (${patchRes.status})`);
        }

        statusEl.textContent = `✓ 已上传：${filename}`;
        statusEl.className = 'upload-status success';
        currentEl.textContent = filename;
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        statusEl.textContent = `✗ 上传失败，请重试（${msg}）`;
        statusEl.className = 'upload-status error';
      }
    }

    function updateGithubTokenStatus() {
      const statusEl = document.getElementById('github-token-status');
      if (!statusEl) return;
      const stored = localStorage.getItem('taskora_github_token');
      if (stored) {
        statusEl.textContent = '✓ Token 已设置';
        statusEl.style.color = '#2D9D5E';
      } else {
        statusEl.textContent = '⚠ 未设置';
        statusEl.style.color = '#D13B3B';
      }
    }

    document.getElementById('github-token-save')?.addEventListener('click', () => {
      const input = document.getElementById('github-token-input') as HTMLInputElement | null;
      if (!input) return;
      const val = input.value.trim();
      if (val) {
        localStorage.setItem('taskora_github_token', val);
        input.value = '';
        updateGithubTokenStatus();
      }
    });

    function setupUploadZone(type: 'apk' | 'zip') {
      const dropZone = document.getElementById(`drop-zone-${type}`) as HTMLDivElement | null;
      const fileInput = document.getElementById(`file-input-${type}`) as HTMLInputElement | null;
      const statusEl = document.getElementById(`upload-status-${type}`) as HTMLElement | null;
      const currentEl = document.getElementById(`drop-zone-${type}-current`) as HTMLElement | null;

      if (!dropZone || !fileInput || !statusEl || !currentEl) return;

      const platform = dropZone.dataset.platform!;
      const filename = dropZone.dataset.filename!;

      // Click to open file picker
      dropZone.addEventListener('click', () => {
        fileInput.click();
      });

      // File input change
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) {
          uploadFile(file, platform, filename, statusEl, currentEl);
          fileInput.value = '';
        }
      });

      // Drag events
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });

      dropZone.addEventListener('dragleave', (e) => {
        // Only remove highlight if leaving the drop zone entirely
        if (!dropZone.contains(e.relatedTarget as Node)) {
          dropZone.classList.remove('dragover');
        }
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        const file = e.dataTransfer?.files?.[0];
        if (file) {
          uploadFile(file, platform, filename, statusEl, currentEl);
        }
      });
    }

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      localStorage.removeItem('taskora_admin_token');
      window.location.href = '/admin-login';
    });

    document.getElementById('links-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('taskora_admin_token');
      if (!token) { window.location.href = '/admin-login'; return; }

      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      const resultEl = document.getElementById('save-result')!;
      btn.disabled = true;
      btn.textContent = '保存中…';
      resultEl.classList.add('hidden');

      // Only save xiaomi + web URL fields (APK/ZIP are uploaded independently)
      const fieldMap: Record<string, string> = {
        'field-android-xiaomi': 'android_xiaomi',
        'field-web': 'web',
      };

      const headers = {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${token}`,
        'Prefer': 'return=minimal',
      };

      const results = await Promise.all(
        Object.entries(fieldMap).map(async ([elId, platform]) => {
          const el = document.getElementById(elId) as HTMLInputElement;
          const url = el.value.trim();
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/download_links?platform=eq.${platform}`,
            { method: 'PATCH', headers, body: JSON.stringify({ url }) }
          );
          if (res.status === 401) {
            localStorage.removeItem('taskora_admin_token');
            window.location.href = '/admin-login';
            return false;
          }
          return res.ok;
        })
      );

      btn.disabled = false;
      btn.textContent = '保存所有链接';

      if (results.every(Boolean)) {
        resultEl.textContent = '✓ 保存成功，下载页已更新';
        resultEl.className = 'save-result success';
      } else {
        resultEl.textContent = '部分保存失败，请重试（token 可能已过期，尝试重新登录）';
        resultEl.className = 'save-result error';
      }
      resultEl.classList.remove('hidden');
    });
  </script>

  <style>
    .status-msg {
      color: var(--sl-color-gray-2);
      text-align: center;
      padding: 2rem;
    }
    .admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .admin-hint {
      color: var(--sl-color-gray-2);
      font-size: 0.875rem;
      margin: 0;
    }
    .logout-btn {
      padding: 0.4rem 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      background: transparent;
      color: var(--sl-color-text);
      cursor: pointer;
      font-size: 0.875rem;
    }
    .logout-btn:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-accent);
    }
    .links-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 640px;
    }
    .link-card {
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .link-label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--sl-color-text);
    }
    .link-card input[type="url"] {
      padding: 0.55rem 0.85rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      font-size: 0.9rem;
      width: 100%;
      box-sizing: border-box;
    }
    .link-card input[type="url"]:focus {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 1px;
    }
    .drop-zone {
      border: 2px dashed var(--sl-color-gray-5);
      border-radius: 8px;
      padding: 1.25rem 1rem;
      text-align: center;
      cursor: pointer;
      background: var(--sl-color-bg);
      transition: border-color 0.15s, background 0.15s;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .drop-zone:hover {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-bg-sidebar);
    }
    .drop-zone.dragover {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-bg-sidebar);
    }
    .drop-zone-hint {
      font-size: 0.875rem;
      color: var(--sl-color-gray-2);
    }
    .drop-zone-current {
      font-size: 0.8rem;
      color: var(--sl-color-gray-3);
    }
    .upload-status {
      font-size: 0.875rem;
      padding: 0.35rem 0;
    }
    .upload-status.loading {
      color: var(--sl-color-gray-2);
    }
    .upload-status.success { color: #2D9D5E; }
    .upload-status.error { color: #D13B3B; }
    .save-btn {
      padding: 0.7rem 2rem;
      border: none;
      border-radius: 8px;
      background: var(--sl-color-accent);
      color: var(--sl-color-white);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      align-self: flex-start;
    }
    .save-btn:disabled {
      opacity: 0.6;
      cursor: default;
    }
    .save-result {
      font-size: 0.875rem;
      padding: 0.5rem 0;
    }
    .save-result.success { color: #2D9D5E; }
    .save-result.error { color: #D13B3B; }
    .github-settings {
      background: var(--sl-color-bg-sidebar);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
    }
    .github-settings-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    .token-status { font-size: 0.85rem; font-weight: normal; }
    .github-settings-body {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .github-token-input {
      flex: 1;
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 6px;
      font-size: 0.875rem;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      font-family: monospace;
    }
    .token-save-btn {
      padding: 0.4rem 1rem;
      background: var(--sl-color-accent);
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.875rem;
      white-space: nowrap;
    }
    .github-token-hint {
      font-size: 0.78rem;
      color: var(--sl-color-gray-3);
      margin-top: 0.5rem;
      margin-bottom: 0;
    }
    .hidden { display: none; }
    [data-theme='dark'] .save-result.success { color: #4ADE80; }
    [data-theme='dark'] .save-result.error { color: #F87171; }
    [data-theme='dark'] .upload-status.success { color: #4ADE80; }
    [data-theme='dark'] .upload-status.error { color: #F87171; }
    [data-theme='dark'] .link-card input[type="url"] {
      border-color: var(--sl-color-gray-4);
    }
    [data-theme='dark'] .drop-zone {
      border-color: var(--sl-color-gray-4);
    }
  </style>
</StarlightPage>
