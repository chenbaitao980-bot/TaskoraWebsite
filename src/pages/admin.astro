---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: '下载链接管理',
    description: 'Taskora 管理员后台 — 管理各平台下载链接',
  }}
>
  <div id="admin-loading" class="status-msg">验证登录状态…</div>
  <div id="admin-content" class="hidden">
    <div class="admin-header">
      <p class="admin-hint">修改链接后点击「保存」立即生效，无需重新部署。</p>
      <button id="logout-btn" class="logout-btn">退出登录</button>
    </div>

    <form id="links-form" class="links-form">
      <div class="link-card">
        <div class="link-label">📱 Android APK 直链</div>
        <input type="file" id="file-input-apk" accept=".apk" class="hidden" />
        <div id="drop-zone-apk" class="drop-zone" data-platform="android_apk" data-filename="taskora-latest.apk">
          <div class="drop-zone-hint">拖拽文件到此处，或点击选择文件</div>
          <div id="drop-zone-apk-current" class="drop-zone-current">暂无文件</div>
        </div>
        <div id="upload-status-apk" class="upload-status hidden"></div>
      </div>
      <div class="link-card">
        <div class="link-label">📱 小米应用商店链接</div>
        <input type="url" id="field-android-xiaomi" name="android_xiaomi" placeholder="https://app.mi.com/details?id=..." />
      </div>
      <div class="link-card">
        <div class="link-label">💻 Windows ZIP 直链</div>
        <input type="file" id="file-input-zip" accept=".zip" class="hidden" />
        <div id="drop-zone-zip" class="drop-zone" data-platform="windows_zip" data-filename="taskora-latest.zip">
          <div class="drop-zone-hint">拖拽文件到此处，或点击选择文件</div>
          <div id="drop-zone-zip-current" class="drop-zone-current">暂无文件</div>
        </div>
        <div id="upload-status-zip" class="upload-status hidden"></div>
      </div>
      <div class="link-card">
        <div class="link-label">🌐 Web 在线版网址</div>
        <input type="url" id="field-web" name="web" placeholder="https://app.taskora.com" />
      </div>

      <button type="submit" class="save-btn" id="save-btn">保存所有链接</button>
      <div id="save-result" class="save-result hidden"></div>
    </form>

    <hr class="section-divider" />

    <form id="payment-form" class="links-form">
      <div class="section-title">💳 支付宝配置</div>
      <div class="link-card">
        <div class="link-label">AppID（16位数字）</div>
        <input type="text" id="field-alipay-appid" placeholder="2088xxxxxxxxxxxxxxx" autocomplete="off" />
      </div>
      <div class="link-card">
        <div class="link-label">应用私钥（PKCS8 格式）</div>
        <textarea id="field-alipay-private-key" rows="4" placeholder="（已设置，留空则不修改）" autocomplete="off" class="config-textarea"></textarea>
      </div>
      <div class="link-card">
        <div class="link-label">支付宝公钥（平台公钥，非应用公钥）</div>
        <textarea id="field-alipay-public-key" rows="4" placeholder="（已设置，留空则不修改）" autocomplete="off" class="config-textarea"></textarea>
      </div>
      <button type="submit" class="save-btn" id="payment-save-btn">保存支付配置</button>
      <div id="payment-save-result" class="save-result hidden"></div>
    </form>

    <hr class="section-divider" />

    <div class="links-form">
      <div class="section-title">📋 支付明细</div>
      <div class="orders-toolbar">
        <select id="orders-status-filter" class="orders-filter">
          <option value="">全部状态</option>
          <option value="pending">待支付</option>
          <option value="paid">已支付</option>
          <option value="closed">已关闭</option>
        </select>
        <button id="orders-refresh-btn" class="orders-refresh-btn">刷新</button>
        <span id="orders-count" class="orders-count"></span>
      </div>
      <div id="orders-loading" class="orders-loading">加载中…</div>
      <div id="orders-table-wrap" class="hidden">
        <table class="orders-table">
          <thead>
            <tr>
              <th>订单号</th>
              <th>套餐</th>
              <th>金额</th>
              <th>状态</th>
              <th>创建时间</th>
              <th>支付时间</th>
            </tr>
          </thead>
          <tbody id="orders-tbody"></tbody>
        </table>
      </div>
      <div id="orders-empty" class="orders-empty hidden">暂无记录</div>
      <div id="orders-error" class="save-result error hidden"></div>
    </div>
  </div>

  <script>
    const SUPABASE_URL = 'https://wlehkvsxftyxmxelcaps.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF';


    const loadingEl = document.getElementById('admin-loading')!;
    const contentEl = document.getElementById('admin-content')!;

    const token = localStorage.getItem('taskora_admin_token');
    if (!token) {
      window.location.href = '/admin-login';
    } else {
      init(token);
    }

    async function init(token: string) {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/download_links?select=platform,url`, {
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${token}`,
        },
      });

      if (res.status === 401) {
        localStorage.removeItem('taskora_admin_token');
        window.location.href = '/admin-login';
        return;
      }

      const rows: { platform: string; url: string }[] = await res.json();
      const linkMap: Record<string, string> = {};
      for (const row of rows) linkMap[row.platform] = row.url ?? '';

      // URL input fields (xiaomi + web)
      const urlFieldMap: Record<string, string> = {
        'field-android-xiaomi': 'android_xiaomi',
        'field-web': 'web',
      };
      for (const [elId, platform] of Object.entries(urlFieldMap)) {
        const el = document.getElementById(elId) as HTMLInputElement | null;
        if (el) el.value = linkMap[platform] ?? '';
      }

      // Upload zone current file display (apk + zip)
      const apkUrl = linkMap['android_apk'] ?? '';
      const zipUrl = linkMap['windows_zip'] ?? '';

      const apkCurrentEl = document.getElementById('drop-zone-apk-current');
      const zipCurrentEl = document.getElementById('drop-zone-zip-current');

      if (apkCurrentEl) {
        apkCurrentEl.textContent = apkUrl ? getFilenameFromUrl(apkUrl) : '暂无文件';
      }
      if (zipCurrentEl) {
        zipCurrentEl.textContent = zipUrl ? getFilenameFromUrl(zipUrl) : '暂无文件';
      }

      loadingEl.classList.add('hidden');
      contentEl.classList.remove('hidden');

      setupUploadZone('apk');
      setupUploadZone('zip');
      initPaymentConfig(token);
      loadOrders(token);
    }

    function getFilenameFromUrl(url: string): string {
      try {
        const parts = url.split('/');
        return parts[parts.length - 1] || url;
      } catch {
        return url;
      }
    }

    async function uploadFile(file: File, platform: string, filename: string, statusEl: HTMLElement, currentEl: HTMLElement) {
      const token = localStorage.getItem('taskora_admin_token');
      if (!token) { window.location.href = '/admin-login'; return; }

      // Disable drop zone and file input during upload
      const dropZone = document.querySelector(`[data-platform="${platform}"]`) as HTMLElement | null;
      const type = platform === 'android_apk' ? 'apk' : 'zip';
      const fileInput = document.getElementById(`file-input-${type}`) as HTMLInputElement | null;
      if (dropZone) dropZone.classList.add('uploading');
      if (fileInput) fileInput.disabled = true;

      statusEl.className = 'upload-status loading';
      statusEl.textContent = `上传中… (${(file.size / 1048576).toFixed(1)} MB)`;
      statusEl.classList.remove('hidden');

      try {
        // Upload via Supabase Edge Function (bypasses GitHub CORS)
        const formData = new FormData();
        formData.append('file', file);
        formData.append('filename', filename);
        formData.append('platform', platform);

        const uploadRes = await fetch(
          'https://wlehkvsxftyxmxelcaps.supabase.co/functions/v1/upload-to-github',
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'apikey': 'sb_publishable_Nz2Ro_4jBthvDwjeQ8m-ww_tT0wYgcF',
            },
            body: formData,
          }
        );

        if (uploadRes.status === 401) {
          localStorage.removeItem('taskora_admin_token');
          window.location.href = '/admin-login';
          return;
        }

        const result = await uploadRes.json();

        if (!uploadRes.ok || result.error) {
          throw new Error(result.error || `上传失败 (${uploadRes.status})`);
        }

        const downloadUrl: string = result.url;

        // Update download_links table
        const patchRes = await fetch(
          `${SUPABASE_URL}/rest/v1/download_links?platform=eq.${platform}`,
          {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'apikey': SUPABASE_ANON_KEY,
              'Authorization': `Bearer ${token}`,
              'Prefer': 'return=minimal',
            },
            body: JSON.stringify({ url: downloadUrl }),
          }
        );

        if (patchRes.status === 401) {
          localStorage.removeItem('taskora_admin_token');
          window.location.href = '/admin-login';
          return;
        }
        if (!patchRes.ok) {
          throw new Error(`链接更新失败 (${patchRes.status})`);
        }

        statusEl.textContent = `✓ 已上传：${filename}`;
        statusEl.className = 'upload-status success';
        currentEl.textContent = filename;
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        statusEl.textContent = `✗ 上传失败，请重试（${msg}）`;
        statusEl.className = 'upload-status error';
      } finally {
        // Re-enable drop zone and file input after upload completes or fails
        if (dropZone) dropZone.classList.remove('uploading');
        if (fileInput) fileInput.disabled = false;
      }
    }

    function setupUploadZone(type: 'apk' | 'zip') {
      const dropZone = document.getElementById(`drop-zone-${type}`) as HTMLDivElement | null;
      const fileInput = document.getElementById(`file-input-${type}`) as HTMLInputElement | null;
      const statusEl = document.getElementById(`upload-status-${type}`) as HTMLElement | null;
      const currentEl = document.getElementById(`drop-zone-${type}-current`) as HTMLElement | null;

      if (!dropZone || !fileInput || !statusEl || !currentEl) return;

      const platform = dropZone.dataset.platform!;
      const filename = dropZone.dataset.filename!;

      // Click to open file picker
      dropZone.addEventListener('click', () => {
        fileInput.click();
      });

      // File input change
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) {
          uploadFile(file, platform, filename, statusEl, currentEl);
          fileInput.value = '';
        }
      });

      // Drag events
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });

      dropZone.addEventListener('dragleave', (e) => {
        // Only remove highlight if leaving the drop zone entirely
        if (!dropZone.contains(e.relatedTarget as Node)) {
          dropZone.classList.remove('dragover');
        }
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        const file = e.dataTransfer?.files?.[0];
        if (file) {
          uploadFile(file, platform, filename, statusEl, currentEl);
        }
      });
    }

    document.getElementById('orders-refresh-btn')?.addEventListener('click', () => {
      const token = localStorage.getItem('taskora_admin_token');
      if (token) loadOrders(token);
    });
    document.getElementById('orders-status-filter')?.addEventListener('change', () => {
      const token = localStorage.getItem('taskora_admin_token');
      if (token) loadOrders(token);
    });

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      localStorage.removeItem('taskora_admin_token');
      window.location.href = '/admin-login';
    });

    // --- 支付明细 ---
    const PLAN_LABELS: Record<string, string> = {
      vip_monthly: '月度 VIP',
      vip_yearly: '年度 VIP',
    };
    const STATUS_LABELS: Record<string, string> = {
      pending: '待支付',
      paid: '已支付',
      closed: '已关闭',
    };
    const STATUS_CLASS: Record<string, string> = {
      pending: 'status-pending',
      paid: 'status-paid',
      closed: 'status-closed',
    };

    function formatDatetime(iso: string | null): string {
      if (!iso) return '—';
      const d = new Date(iso);
      return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    }

    async function loadOrders(token: string) {
      const statusFilter = (document.getElementById('orders-status-filter') as HTMLSelectElement).value;
      const loadingEl = document.getElementById('orders-loading')!;
      const tableWrap = document.getElementById('orders-table-wrap')!;
      const emptyEl = document.getElementById('orders-empty')!;
      const errorEl = document.getElementById('orders-error')!;
      const tbody = document.getElementById('orders-tbody')!;
      const countEl = document.getElementById('orders-count')!;

      loadingEl.classList.remove('hidden');
      tableWrap.classList.add('hidden');
      emptyEl.classList.add('hidden');
      errorEl.classList.add('hidden');

      try {
        let url = `${SUPABASE_URL}/rest/v1/payment_orders?select=out_trade_no,plan,amount,status,created_at,paid_at&order=created_at.desc&limit=100`;
        if (statusFilter) url += `&status=eq.${statusFilter}`;

        const res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': `Bearer ${token}`,
          },
        });

        if (res.status === 401) {
          localStorage.removeItem('taskora_admin_token');
          window.location.href = '/admin-login';
          return;
        }
        if (!res.ok) throw new Error(`请求失败 (${res.status})`);

        const orders: { out_trade_no: string; plan: string; amount: string; status: string; created_at: string; paid_at: string | null }[] = await res.json();

        loadingEl.classList.add('hidden');
        countEl.textContent = `共 ${orders.length} 条`;

        if (orders.length === 0) {
          emptyEl.classList.remove('hidden');
          return;
        }

        tbody.innerHTML = orders.map(o => `
          <tr>
            <td class="order-no" title="${o.out_trade_no}">${o.out_trade_no.slice(-12)}</td>
            <td>${PLAN_LABELS[o.plan] || o.plan}</td>
            <td>¥${o.amount}</td>
            <td><span class="status-badge ${STATUS_CLASS[o.status] || ''}">${STATUS_LABELS[o.status] || o.status}</span></td>
            <td>${formatDatetime(o.created_at)}</td>
            <td>${formatDatetime(o.paid_at)}</td>
          </tr>
        `).join('');
        tableWrap.classList.remove('hidden');
      } catch (err: unknown) {
        loadingEl.classList.add('hidden');
        errorEl.textContent = `加载失败：${err instanceof Error ? err.message : String(err)}`;
        errorEl.classList.remove('hidden');
      }
    }

    // --- 支付配置 ---
    async function initPaymentConfig(token: string) {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/app_config?key=in.(alipay_app_id,alipay_private_key,alipay_public_key)&select=key,value`,
        { headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${token}` } }
      );
      if (res.status === 401) return;
      const rows: { key: string; value: string }[] = await res.json();
      const cfg: Record<string, string> = {};
      for (const r of rows) cfg[r.key] = r.value;

      const appidEl = document.getElementById('field-alipay-appid') as HTMLInputElement;
      if (appidEl && cfg.alipay_app_id) appidEl.value = cfg.alipay_app_id;
      // 私钥/公钥：已设置则只更新 placeholder，不回显原文
      const privateKeyEl = document.getElementById('field-alipay-private-key') as HTMLTextAreaElement;
      const publicKeyEl = document.getElementById('field-alipay-public-key') as HTMLTextAreaElement;
      if (privateKeyEl && cfg.alipay_private_key) privateKeyEl.placeholder = '（已设置，留空则不修改）';
      if (publicKeyEl && cfg.alipay_public_key) publicKeyEl.placeholder = '（已设置，留空则不修改）';
    }

    document.getElementById('payment-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('taskora_admin_token');
      if (!token) { window.location.href = '/admin-login'; return; }

      const btn = document.getElementById('payment-save-btn') as HTMLButtonElement;
      const resultEl = document.getElementById('payment-save-result')!;
      btn.disabled = true;
      btn.textContent = '保存中…';
      resultEl.classList.add('hidden');

      const appid = (document.getElementById('field-alipay-appid') as HTMLInputElement).value.trim();
      const privateKey = (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).value.trim();
      const publicKey = (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).value.trim();

      const records: { key: string; value: string }[] = [];
      if (appid) records.push({ key: 'alipay_app_id', value: appid });
      if (privateKey) records.push({ key: 'alipay_private_key', value: privateKey });
      if (publicKey) records.push({ key: 'alipay_public_key', value: publicKey });
      // 固定值
      records.push({ key: 'alipay_gateway', value: 'https://openapi.alipay.com/gateway.do' });
      records.push({ key: 'alipay_notify_url', value: 'https://wlehkvsxftyxmxelcaps.supabase.co/functions/v1/alipay-notify' });

      if (records.length === 2) {
        // 只有固定值，没有填任何内容
        btn.disabled = false;
        btn.textContent = '保存支付配置';
        resultEl.textContent = '请至少填写 AppID、私钥或公钥';
        resultEl.className = 'save-result error';
        resultEl.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/app_config`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': `Bearer ${token}`,
            'Prefer': 'resolution=merge-duplicates',
          },
          body: JSON.stringify(records),
        });
        if (res.status === 401) {
          localStorage.removeItem('taskora_admin_token');
          window.location.href = '/admin-login';
          return;
        }
        if (!res.ok) throw new Error(`保存失败 (${res.status})`);

        resultEl.textContent = '✓ 支付配置已保存';
        resultEl.className = 'save-result success';
        // 清空私钥/公钥输入框，更新 placeholder
        (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).value = '';
        (document.getElementById('field-alipay-private-key') as HTMLTextAreaElement).placeholder = '（已设置，留空则不修改）';
        (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).value = '';
        (document.getElementById('field-alipay-public-key') as HTMLTextAreaElement).placeholder = '（已设置，留空则不修改）';
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        resultEl.textContent = `✗ ${msg}`;
        resultEl.className = 'save-result error';
      } finally {
        btn.disabled = false;
        btn.textContent = '保存支付配置';
        resultEl.classList.remove('hidden');
      }
    });

    document.getElementById('links-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('taskora_admin_token');
      if (!token) { window.location.href = '/admin-login'; return; }

      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      const resultEl = document.getElementById('save-result')!;
      btn.disabled = true;
      btn.textContent = '保存中…';
      resultEl.classList.add('hidden');

      // Only save xiaomi + web URL fields (APK/ZIP are uploaded independently)
      const fieldMap: Record<string, string> = {
        'field-android-xiaomi': 'android_xiaomi',
        'field-web': 'web',
      };

      const headers = {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${token}`,
        'Prefer': 'return=minimal',
      };

      const results = await Promise.all(
        Object.entries(fieldMap).map(async ([elId, platform]) => {
          const el = document.getElementById(elId) as HTMLInputElement;
          const url = el.value.trim();
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/download_links?platform=eq.${platform}`,
            { method: 'PATCH', headers, body: JSON.stringify({ url }) }
          );
          if (res.status === 401) {
            localStorage.removeItem('taskora_admin_token');
            window.location.href = '/admin-login';
            return false;
          }
          return res.ok;
        })
      );

      btn.disabled = false;
      btn.textContent = '保存所有链接';

      if (results.every(Boolean)) {
        resultEl.textContent = '✓ 保存成功，下载页已更新';
        resultEl.className = 'save-result success';
      } else {
        resultEl.textContent = '部分保存失败，请重试（token 可能已过期，尝试重新登录）';
        resultEl.className = 'save-result error';
      }
      resultEl.classList.remove('hidden');
    });
  </script>

  <style>
    .status-msg {
      color: var(--sl-color-gray-2);
      text-align: center;
      padding: 2rem;
    }
    .admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .admin-hint {
      color: var(--sl-color-gray-2);
      font-size: 0.875rem;
      margin: 0;
    }
    .logout-btn {
      padding: 0.4rem 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      background: transparent;
      color: var(--sl-color-text);
      cursor: pointer;
      font-size: 0.875rem;
    }
    .logout-btn:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-accent);
    }
    .links-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 640px;
    }
    .link-card {
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .link-label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--sl-color-text);
    }
    .link-card input[type="url"] {
      padding: 0.55rem 0.85rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      font-size: 0.9rem;
      width: 100%;
      box-sizing: border-box;
    }
    .link-card input[type="url"]:focus {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 1px;
    }
    .drop-zone {
      border: 2px dashed var(--sl-color-gray-5);
